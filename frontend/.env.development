# Loaded automatically by `expo start` (NODE_ENV=development).
# Leave EXPO_PUBLIC_API_URL unset to use the platform-aware default
# (http://localhost:5180, or http://10.0.2.2:5180 on Android emulators).
#
# Testing on a physical device? Point at your machine's LAN IP instead:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:5180

# Google SSO (optional). The "Continue with Google" button only appears once
# at least one of these is set. Create OAuth client IDs in Google Cloud Console
# (APIs & Services -> Credentials):
#   - Web client id: used by Expo Go / web, and is the audience the backend
#     verifies against (set the same value as Sso:Google:ClientId on the API).
#   - Android client id: used by the installed app (needs your SHA-1 fingerprint).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
