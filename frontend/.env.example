# Template for local overrides. Copy any line you need into .env.local
# (gitignored). For day-to-day local dev you normally don't have to:
# `npm start` runs scripts/sync-local-env.js, which writes your current LAN IP
# into .env.local automatically so a physical device can reach Metro + the API.

# Target environment: local | development | qa | production
# Defaults to "local"; EAS build profiles (eas.json) set this for cloud builds.
# EXPO_PUBLIC_APP_ENV=local

# --- local environment ---
# Host/port of the API on your machine. The sync script fills HOST with your
# LAN IP; PORT defaults to 5180. Leave unset to use the platform default
# (http://localhost:5180, or http://10.0.2.2:5180 on Android emulators).
# EXPO_PUBLIC_LOCAL_API_HOST=192.168.1.20
# EXPO_PUBLIC_LOCAL_API_PORT=5180

# --- development / qa / production ---
# The full API origin (required when APP_ENV is not "local").
# EXPO_PUBLIC_API_URL=https://api.lvlup.example.com

# --- Google SSO (optional) ---
# The "Continue with Google" button appears once at least one is set. Create
# OAuth client IDs in Google Cloud Console (APIs & Services -> Credentials).
# The web client id is also the audience the backend verifies (set the same
# value as Sso:Google:ClientId on the API).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
