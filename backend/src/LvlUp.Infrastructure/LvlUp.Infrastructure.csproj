<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LvlUp.Application\LvlUp.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- Pin Relational to match EF Core 10.0.9 used elsewhere; Npgsql 10.0.2 otherwise
         pulls 10.0.4, which causes an MSB3277 version-conflict warning in dependents. -->
